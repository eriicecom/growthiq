# Supabase (frontend + backend)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Supabase (solo Netlify Functions — usar Service Role Key)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Shopify Webhooks (obtener desde Shopify Admin → Configuración → Notificaciones → Webhooks)
# Dejar vacío en desarrollo; en producción poner el secreto de firma de Shopify
SHOPIFY_WEBHOOK_SECRET=
